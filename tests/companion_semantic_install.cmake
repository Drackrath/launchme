if(NOT IS_DIRECTORY "${BUILD_DIR}" OR NOT EXISTS "${TEST_EXE}")
    message(FATAL_ERROR "Build the application and semantic tests before package verification.")
endif()
set(package "${BUILD_DIR}/semantic-package-test")
# Linux (cmake/Linux.cmake): ONNX Runtime under its SONAME, found through the program's $ORIGIN RPATH.
if(CMAKE_HOST_WIN32)
    set(runtime onnxruntime.dll)
    set(check semantic-package-check.exe)
else()
    set(runtime libonnxruntime.so.1)
    set(check semantic-package-check)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}" --component Runtime --prefix "${package}"
    RESULT_VARIABLE installed)
if(NOT installed EQUAL 0)
    message(FATAL_ERROR "Runtime installation failed.")
endif()
foreach(file ${runtime} assets/companion-embeddings/model.onnx assets/companion-embeddings/sentencepiece.bpe.model
        assets/companion-embeddings/onnxruntime-license.txt assets/companion-embeddings/sentencepiece-license.txt assets/companion-embeddings/companion-embeddings-NOTICE.txt)
    if(NOT EXISTS "${package}/${file}")
        message(FATAL_ERROR "Missing package asset: ${file}")
    endif()
endforeach()
if(CMAKE_HOST_WIN32 AND NOT EXISTS "${package}/launchme.exe")
    message(FATAL_ERROR "Missing package asset: launchme.exe")
endif()
file(COPY_FILE "${TEST_EXE}" "${package}/${check}" ONLY_IF_DIFFERENT)
execute_process(COMMAND "${package}/${check}" --model WORKING_DIRECTORY "${package}"
    RESULT_VARIABLE checked TIMEOUT 180)
file(REMOVE "${package}/${check}")
if(NOT checked EQUAL 0)
    message(FATAL_ERROR "Packaged model/runtime verification failed: ${checked}")
endif()
file(SIZE "${package}/assets/companion-embeddings/model.onnx" model_bytes)
file(SIZE "${package}/assets/companion-embeddings/sentencepiece.bpe.model" tokenizer_bytes)
file(SIZE "${package}/${runtime}" runtime_bytes)
math(EXPR bytes "${model_bytes}+${tokenizer_bytes}+${runtime_bytes}")
message(STATUS "Semantic runtime + model + tokenizer: ${bytes} bytes")
