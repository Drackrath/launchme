# Linux: her pictures and the phone page in the binary, under the numbers the Windows build gives
# them as RCDATA (cmake/CompanionManifest.cmake, CMakeLists.txt). Each file is assembled in with
# .incbin (no 100 MB byte-array source); generated/companion_resources.cpp holds them and the table
# src/platform/embedded_resources.cpp looks them up in. Only targets that link
# launchme_companion_resources carry them. Needs LAUNCHME_RES_DIR and LAUNCHME_COMPANION_RESOURCES.
set(LAUNCHME_EMBEDDED ${LAUNCHME_COMPANION_RESOURCES} "65000|${LAUNCHME_RES_DIR}/remote/index.html")
list(SORT LAUNCHME_EMBEDDED COMPARE NATURAL) # By number: the table is binary-searched.
set(LAUNCHME_EMBEDDED_ASM "")
set(LAUNCHME_EMBEDDED_DECLARATIONS "")
set(LAUNCHME_EMBEDDED_ENTRIES "")
set(LAUNCHME_EMBEDDED_FILES "")
foreach(entry IN LISTS LAUNCHME_EMBEDDED)
    string(REGEX MATCH "^([0-9]+)\\|(.*)$" matched "${entry}")
    set(id "${CMAKE_MATCH_1}")
    set(file "${CMAKE_MATCH_2}")
    list(APPEND LAUNCHME_EMBEDDED_FILES "${file}")
    string(REPLACE "\\" "\\\\" quoted "${file}")
    string(REPLACE "\"" "\\\"" quoted "${quoted}")
    set(symbol "launchme_resource_${id}")
    string(APPEND LAUNCHME_EMBEDDED_ASM ".globl ${symbol}, ${symbol}_end\n.hidden ${symbol}, ${symbol}_end\n.balign 16\n"
        "${symbol}:\n.incbin \"${quoted}\"\n${symbol}_end:\n")
    string(APPEND LAUNCHME_EMBEDDED_DECLARATIONS "extern const uint8_t ${symbol}[], ${symbol}_end[];\n")
    string(APPEND LAUNCHME_EMBEDDED_ENTRIES "    {${id}, ${symbol}, ${symbol}_end},\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/companion_resources.cpp.new"
"// Generated by cmake/CompanionResources.cmake from res/companion/ and res/remote/index.html.
#include \"platform/embedded_resources.hpp\"

#include <iterator>

__asm__(R\"launchme(.section .rodata.launchme_resources,\"a\",@progbits
${LAUNCHME_EMBEDDED_ASM}.previous
)launchme\");

extern \"C\" {
${LAUNCHME_EMBEDDED_DECLARATIONS}extern const embedded_resources::Table launchme_embedded_resources;
}

namespace {
const embedded_resources::Entry entries[] = {
${LAUNCHME_EMBEDDED_ENTRIES}};
}
const embedded_resources::Table launchme_embedded_resources{entries, std::size(entries)};
")
# Rewritten only when it changes (no rebuild of 100 MB on every configure).
file(COPY_FILE "${CMAKE_CURRENT_BINARY_DIR}/generated/companion_resources.cpp.new"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/companion_resources.cpp" ONLY_IF_DIFFERENT)
add_library(launchme_companion_resources OBJECT "${CMAKE_CURRENT_BINARY_DIR}/generated/companion_resources.cpp")
target_compile_features(launchme_companion_resources PRIVATE cxx_std_20)
target_include_directories(launchme_companion_resources PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
set_source_files_properties("${CMAKE_CURRENT_BINARY_DIR}/generated/companion_resources.cpp" PROPERTIES OBJECT_DEPENDS "${LAUNCHME_EMBEDDED_FILES}")
