{
  "name": "launchme-www",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The launchme website, published to GitHub Pages by .github/workflows/pages.yml.",
  "scripts": {
    "dev": "vite",
    "assets": "python scripts/prepare_assets.py",
    "art": "python scripts/import_art.py",
    "icons": "node scripts/icons.mjs",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
